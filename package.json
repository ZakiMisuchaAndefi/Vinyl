{
  "name": "vinyl",
  "version": "1.1.0",
  "private": true,
  "description": "Pemutar musik streaming bergaya semi-Apple Music di browser, lengkap dengan FLAC lossless dan unduhan langsung dari browser.",
  "author": "ZakiMisuchaAndefi",
  "license": "GPL-3.0-or-later",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --win nsis --publish always",
    "release:mac": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "id.vinyl.desktop",
    "productName": "Vinyl",
    "copyright": "Copyright © 2026 Vinyl",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack-mac.js",
    "files": [
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "api/**/*",
      "electron/**/*",
      "build/icon.ico",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!**/*.map"
    ],
    "extraResources": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "ZakiMisuchaAndefi",
      "repo": "Vinyl",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vinyl",
      "artifactName": "Vinyl-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "darkModeSupport": true,
      "artifactName": "Vinyl-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Vinyl-${version}-${arch}.${ext}",
      "backgroundColor": "#0b0b0d",
      "window": {
        "width": 560,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
